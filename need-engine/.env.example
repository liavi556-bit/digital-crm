# ---- LLM (pick one; with none set, the offline rule-based engine is used) ----
# rules | anthropic | openai
LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Any OpenAI-compatible endpoint (OpenAI, Gemini compat, OpenRouter, Ollama http://localhost:11434/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Search discovery layer (optional). google-news-rss needs no key ----
SEARCH_PROVIDER=google-news-rss
# Reserved for future providers (Brave / Serper / Google CSE):
SEARCH_API_KEY=

# ---- Pipeline ----
CONNECTORS=rss,search,ckan          # add "fixture" for synthetic offline data
MAX_AGE_DAYS=45                     # older signals are rejected as stale
HQ_MIN_CONFIDENCE=0.6               # "high quality" threshold
HTTP_MIN_INTERVAL_MS=1500           # per-host politeness delay
HTTP_CACHE_TTL_S=1800
HTTP_RETRIES=3
USER_AGENT=NeedEnginePOC/0.1 (+contact: set-your-email@example.com)

# ---- Server / DB ----
PORT=3000
DB_PATH=data/need-engine.db
